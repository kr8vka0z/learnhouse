# Local preview settings. Don't copy this by hand: ./make-env.sh writes .env
# with fresh random secrets. Every value left empty here is generated.

# Port on 127.0.0.1 where the app is served.
HTTP_PORT=3300

# Docker Compose project: containers, volumes and the app image are named
# after it, so a second stack with another name never touches the first.
COMPOSE_PROJECT_NAME=lh-preview

# Created automatically on the first boot of an empty database.
LEARNHOUSE_INITIAL_ORG_NAME=Rescue Ready
LEARNHOUSE_INITIAL_ORG_SLUG=rescue-ready
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@example.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=

# Shared password for the seeded students (seed.py).
PREVIEW_STUDENT_PASSWORD=

# Org branding applied by seed.py through the org-settings endpoints. Image
# files are optional (PNG/JPG/WebP; SVG is refused by the upload validator)
# and are never committed. Uncomment to use; they can also be passed in the
# environment when running seed.py. The wide logo sits on the menu bar, which
# takes the brand color, so use a light-on-dark logo with a dark color. The
# square logo shows on the sign-in panel and in the dashboard.
# PREVIEW_LOGO_FILE=/path/to/wide-logo.png
# PREVIEW_SQUARE_LOGO_FILE=/path/to/square-logo.png
# PREVIEW_FAVICON_FILE=/path/to/favicon.png
# PREVIEW_BRAND_COLOR=#0B1F5C

# AGPL source link in the site footer (defaults to this fork's repository).
# NEXT_PUBLIC_RR_SOURCE_URL=https://github.com/kr8vka0z/learnhouse

POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
COLLAB_INTERNAL_KEY=

# Email is not configured; nothing is sent from a preview.
LEARNHOUSE_EMAIL_PROVIDER=resend
