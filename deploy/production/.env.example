# Production settings for docker-compose.yml. Copy to .env in the data folder,
# fill every empty value, then `chmod 600 .env`. Secrets: generate each one
# fresh (for example `python3 -c 'import secrets; print(secrets.token_urlsafe(32))'`)
# and keep a copy in your password manager; the database keeps the first
# POSTGRES_PASSWORD it was created with.

# App image tag built from this repository (see README), e.g. lh-prod:<shortsha>.
LH_IMAGE=
# Public host name, no scheme or port, e.g. learn.example.com.
LH_PUBLIC_HOST=
# Its registrable parent domain, e.g. example.com.
LH_TOP_DOMAIN=
# Port on 127.0.0.1 that the proxy or tunnel forwards to.
LH_HTTP_PORT=3330
# The organization slug (same value as LEARNHOUSE_INITIAL_ORG_SLUG below).
LH_ORG_SLUG=
# Fixed subnet for the stack network, so a host firewall can target it.
LH_SUBNET=172.30.30.0/24

# First boot only: an empty database gets this organization and admin. The
# slug is permanent. Delete these four lines once the first boot is done (the
# admin password then lives only in your password manager).
LEARNHOUSE_INITIAL_ORG_NAME=
LEARNHOUSE_INITIAL_ORG_SLUG=
LEARNHOUSE_INITIAL_ADMIN_EMAIL=
# Needs a letter, a digit and a symbol.
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=

POSTGRES_PASSWORD=
# At least 32 characters.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=

# Outgoing mail (invitations, password resets). The sender must be on a domain
# verified with the provider.
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=
# Shown as the instance contact; upstream defaults to its own address.
LEARNHOUSE_CONTACT_EMAIL=

# Footer "Source code" link (AGPL source offer); defaults to this fork.
# NEXT_PUBLIC_RR_SOURCE_URL=https://github.com/kr8vka0z/learnhouse

# IANA zone for times in completion reports (fork setting).
LEARNHOUSE_REPORT_TIMEZONE=America/Denver

LEARNHOUSE_IS_AI_ENABLED=False
